{
  "name": "gymapp",
  "version": "0.0.1",
  "private": true,
  "description": "Recomp Tracker - monorepo",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "pnpm --filter api dev & pnpm --filter web dev",
    "build": "pnpm -r build",
    "db:generate": "pnpm --filter @gymapp/db generate",
    "db:migrate": "pnpm --filter @gymapp/db migrate",
    "db:seed": "pnpm --filter @gymapp/db seed"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
